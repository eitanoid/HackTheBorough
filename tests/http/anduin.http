# Run the backend with a working DATABASE_URL, then execute these requests in
# httpyac CLI/extension (the request assertions use httpyac syntax).
# CLI: cd tests/http && httpyac send anduin.http, then choose a request region.
# Connect unary methods use the JSON codec and regular HTTP POST requests.

@baseUrl = http://127.0.0.1:8081
@projectId = replace-with-an-existing-project-uuid
@workflowId = replace-with-an-existing-workflow-uuid

### Liveness
GET {{baseUrl}}/healthz

### Create an RSS source (default polling interval is 300 seconds)
# @name createRssSource
POST {{baseUrl}}/hacktheburgh.v1.AnduinService/CreateSource
Content-Type: application/json
Connect-Protocol-Version: 1

{
  "name": "Manual RSS source",
  "kind": "SOURCE_KIND_RSS",
  "config": {
    "url": "https://example.com/feed.xml"
  }
}

?? status == 200
?? body source.id exists
?? body source.pollIntervalSeconds == 300

### List sources
POST {{baseUrl}}/hacktheburgh.v1.AnduinService/ListSources
Content-Type: application/json
Connect-Protocol-Version: 1

{}

?? status == 200
?? body sources isArray

### Get the source created above
# @ref createRssSource
POST {{baseUrl}}/hacktheburgh.v1.AnduinService/GetSource
Content-Type: application/json
Connect-Protocol-Version: 1

{
  "id": "{{createRssSource.source.id}}"
}

?? status == 200
?? body source.id exists

### Upload a CSV source (csvData is base64-encoded UTF-8)
# @name uploadCsv
POST {{baseUrl}}/hacktheburgh.v1.AnduinService/UploadCSVSource
Content-Type: application/json
Connect-Protocol-Version: 1

{
  "name": "Manual CSV source",
  "fileName": "rows.csv",
  "csvData": "ZGF0ZSx2YWx1ZQoyMDI2LTAxLTAxLDQKMjAyNi0wMS0wMiw3Cg=="
}

?? status == 200
?? body source.kind == SOURCE_KIND_CSV
?? body source.recordCount == 2

### Verify uploaded CSV records
# @ref uploadCsv
POST {{baseUrl}}/hacktheburgh.v1.AnduinService/GetSource
Content-Type: application/json
Connect-Protocol-Version: 1

{
  "id": "{{uploadCsv.source.id}}"
}

?? status == 200
?? body recentRecords isArray
?? js response.parsedBody.recentRecords.length == 2

### Create a web source with typed extraction and pagination options
POST {{baseUrl}}/hacktheburgh.v1.AnduinService/CreateSource
Content-Type: application/json
Connect-Protocol-Version: 1

{
  "name": "Manual web source",
  "kind": "SOURCE_KIND_WEB",
  "config": {
    "url": "https://example.com/data",
    "query": "Extract daily records",
    "schema": {
      "type": "object",
      "properties": {
        "date": { "type": "string" },
        "value": { "type": "number" }
      }
    },
    "pagination": {
      "strategy": "PAGINATION_STRATEGY_NEXT",
      "maxPages": 5
    }
  }
}

?? status == 200
?? body source.kind == SOURCE_KIND_WEB

### Invalid request should return Connect InvalidArgument (HTTP 400)
POST {{baseUrl}}/hacktheburgh.v1.AnduinService/CreateSource
Content-Type: application/json
Connect-Protocol-Version: 1

{
  "name": "Bad RSS source",
  "kind": "SOURCE_KIND_RSS",
  "config": { "url": "not-a-url" }
}

?? status == 400
?? body code == invalid_argument

### Trigger an immediate source poll over HTTP
# @ref createRssSource
POST {{baseUrl}}/api/sources/{{createRssSource.source.id}}/poll

### Create a project from the uploaded source
# @ref uploadCsv
# @name createProject
POST {{baseUrl}}/hacktheburgh.v1.AnduinService/CreateProject
Content-Type: application/json
Connect-Protocol-Version: 1

{
  "name": "Manual project",
  "goal": "Explore the uploaded data",
  "sourceIds": [ "{{uploadCsv.source.id}}" ]
}

?? status == 200
?? body project.id exists
?? body project.name == Manual project
?? body project.sourceIds isArray

### Invalid project input should return Connect InvalidArgument (HTTP 400)
POST {{baseUrl}}/hacktheburgh.v1.AnduinService/CreateProject
Content-Type: application/json
Connect-Protocol-Version: 1

{ "name": "Invalid project", "sourceIds": [] }

?? status == 400
?? body code == invalid_argument

### Project list is available; read RPCs need an existing project/workflow id
POST {{baseUrl}}/hacktheburgh.v1.AnduinService/ListProjects
Content-Type: application/json
Connect-Protocol-Version: 1

{}

### Get the project created above
# @ref createProject
POST {{baseUrl}}/hacktheburgh.v1.AnduinService/GetProject
Content-Type: application/json
Connect-Protocol-Version: 1

{ "id": "{{createProject.project.id}}" }

### List insights for an existing project
# @ref createProject
POST {{baseUrl}}/hacktheburgh.v1.AnduinService/ListInsights
Content-Type: application/json
Connect-Protocol-Version: 1

{ "projectId": "{{createProject.project.id}}" }

### List workflow versions for an existing project
# @ref createProject
POST {{baseUrl}}/hacktheburgh.v1.AnduinService/ListWorkflows
Content-Type: application/json
Connect-Protocol-Version: 1

{ "projectId": "{{createProject.project.id}}" }

### List recorded steps for an existing workflow
POST {{baseUrl}}/hacktheburgh.v1.AnduinService/ListWorkflowSteps
Content-Type: application/json
Connect-Protocol-Version: 1

{ "workflowId": "{{workflowId}}" }

### Manually replay the investigation's recorded steps (no LLM call; FailedPrecondition until an investigation exists)
# @ref createProject
### Force-run the active statistical workflow without requiring new data
# Requires an active statistical workflow and data for the created project.
# @ref createProject
# @name forceRunWorkflow
POST {{baseUrl}}/hacktheburgh.v1.AnduinService/RunWorkflow
Content-Type: application/json
Connect-Protocol-Version: 1

{ "projectId": "{{createProject.project.id}}", "kind": "WORKFLOW_KIND_INVESTIGATION" }

### Regeneration and replay currently return FailedPrecondition until their services are wired
{
  "projectId": "{{createProject.project.id}}",
  "kind": "WORKFLOW_KIND_STATISTICAL"
}

?? status == 200
?? body.accepted == true

### Delete an unlinked source (destructive)
# Deleting a linked source also clears workflow runs and insights for affected projects.
# @ref createRssSource
POST {{baseUrl}}/hacktheburgh.v1.AnduinService/DeleteSource
Content-Type: application/json
Connect-Protocol-Version: 1

{ "id": "{{createRssSource.source.id}}" }

?? status == 200
?? body.deleted == true

### Delete the project created above (destructive; data sources remain)
# @ref createProject
POST {{baseUrl}}/hacktheburgh.v1.AnduinService/DeleteProject
Content-Type: application/json
Connect-Protocol-Version: 1

{ "id": "{{createProject.project.id}}" }

?? status == 200
?? body.deleted == true

### Workflow regeneration is not configured yet
POST {{baseUrl}}/hacktheburgh.v1.AnduinService/RegenerateWorkflow
Content-Type: application/json
Connect-Protocol-Version: 1

{ "projectId": "{{projectId}}", "kind": "WORKFLOW_KIND_STATISTICAL" }

?? status == 412
?? body code == failed_precondition

### Demo replay is not configured yet
# @ref uploadCsv
POST {{baseUrl}}/hacktheburgh.v1.AnduinService/Replay
Content-Type: application/json
Connect-Protocol-Version: 1

{ "sourceIds": [ "{{uploadCsv.source.id}}" ], "periodsPerSecond": 10, "startFraction": 0.5 }

?? status == 412
?? body code == failed_precondition
