{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": "container",
  "height": 200,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "data": {
    "values": [
      {
        "t": "2026-10-01T00:00:00Z",
        "s": "X",
        "v": 10
      },
      {
        "t": "2026-10-01T00:00:00Z",
        "s": "Y",
        "v": 100
      },
      {
        "t": "2026-10-02T00:00:00Z",
        "s": "X",
        "v": null
      },
      {
        "t": "2026-10-02T00:00:00Z",
        "s": "Y",
        "v": 90
      },
      {
        "t": "2026-10-03T00:00:00Z",
        "s": "X",
        "v": 15
      },
      {
        "t": "2026-10-03T00:00:00Z",
        "s": "Y",
        "v": null
      },
      {
        "t": "2026-10-04T00:00:00Z",
        "s": "X",
        "v": 11
      },
      {
        "t": "2026-10-04T00:00:00Z",
        "s": "Y",
        "v": 95
      }
    ]
  },
  "transform": [
    {
      "groupby": [
        "s"
      ],
      "joinaggregate": [
        {
          "as": "mean",
          "field": "v",
          "op": "mean"
        },
        {
          "as": "sd",
          "field": "v",
          "op": "stdev"
        }
      ]
    },
    {
      "as": "z",
      "calculate": "datum.v == null ? null : (datum.sd \u003e 0 ? (datum.v - datum.mean) / datum.sd : 0)"
    }
  ],
  "layer": [
    {
      "mark": {
        "invalid": "break-paths-filter-domains",
        "type": "line"
      },
      "encoding": {
        "color": {
          "field": "s",
          "legend": {
            "title": null
          },
          "scale": {
            "domain": [
              "X",
              "Y"
            ]
          },
          "type": "nominal"
        },
        "x": {
          "axis": {
            "title": null
          },
          "field": "t",
          "scale": {
            "nice": false
          },
          "type": "temporal"
        },
        "y": {
          "axis": {
            "title": "Standardised value"
          },
          "field": "z",
          "scale": {
            "zero": false
          },
          "type": "quantitative"
        }
      }
    },
    {
      "mark": {
        "opacity": 0,
        "size": 80,
        "type": "point"
      },
      "encoding": {
        "color": {
          "field": "s",
          "legend": {
            "title": null
          },
          "scale": {
            "domain": [
              "X",
              "Y"
            ]
          },
          "type": "nominal"
        },
        "tooltip": [
          {
            "field": "t",
            "format": "%d %b %Y",
            "title": "Date",
            "type": "temporal"
          },
          {
            "field": "s",
            "title": "Series",
            "type": "nominal"
          },
          {
            "field": "v",
            "format": ".3~g",
            "title": "Value",
            "type": "quantitative"
          }
        ],
        "x": {
          "axis": {
            "title": null
          },
          "field": "t",
          "scale": {
            "nice": false
          },
          "type": "temporal"
        },
        "y": {
          "axis": {
            "title": "Standardised value"
          },
          "field": "z",
          "scale": {
            "zero": false
          },
          "type": "quantitative"
        }
      }
    }
  ]
}
