{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": "container",
  "height": 200,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "data": {
    "values": [
      {
        "x": -2,
        "y": 5
      },
      {
        "x": -1,
        "y": 3
      },
      {
        "x": 0,
        "y": 1
      },
      {
        "x": 1,
        "y": -1
      },
      {
        "x": 2,
        "y": -4
      }
    ]
  },
  "layer": [
    {
      "mark": {
        "type": "point"
      },
      "encoding": {
        "tooltip": [
          {
            "field": "x",
            "format": ".3~g",
            "title": "Strike headlines",
            "type": "quantitative"
          },
          {
            "field": "y",
            "format": ".3~g",
            "title": "Bus trips",
            "type": "quantitative"
          }
        ],
        "x": {
          "axis": {
            "title": "Strike headlines (articles)"
          },
          "field": "x",
          "scale": {
            "zero": false
          },
          "type": "quantitative"
        },
        "y": {
          "axis": {
            "title": "Bus trips (trips), 2 days later"
          },
          "field": "y",
          "scale": {
            "zero": false
          },
          "type": "quantitative"
        }
      }
    },
    {
      "mark": {
        "style": "trend",
        "type": "line"
      },
      "transform": [
        {
          "on": "x",
          "regression": "y"
        }
      ],
      "encoding": {
        "x": {
          "axis": {
            "title": "Strike headlines (articles)"
          },
          "field": "x",
          "scale": {
            "zero": false
          },
          "type": "quantitative"
        },
        "y": {
          "axis": {
            "title": "Bus trips (trips), 2 days later"
          },
          "field": "y",
          "scale": {
            "zero": false
          },
          "type": "quantitative"
        }
      }
    }
  ]
}
